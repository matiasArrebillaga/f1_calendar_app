/* =========================================================
   F1 Calendar App — tema "transmisión"
   Paleta:
     bg-app:        #0b0b0e
     bg-panel:      #17171d
     bg-surface:    #1e1e26
     bg-surface-h:  #262631
     border:        #2a2a33
     border-strong: #3a3a45
     text-primary:  #f0f0f0
     text-muted:    #9a9aa5
     accent (rojo): #e10600
     accent-hover:  #ff2410
     accent-press:  #a80500
   ========================================================= */

QWidget {
    background-color: #0b0b0e;
    color: #f0f0f0;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0b0b0e;
}

/* ---------- Barra superior ---------- */

QWidget#topBar {
    background-color: #111116;
    border-bottom: 1px solid #2a2a33;
}

QLabel#tituloApp {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #f0f0f0;
}

QPushButton#botonAnio {
    background-color: #1e1e26;
    color: #f0f0f0;
    border: 1px solid #3a3a45;
    border-radius: 4px;
    padding: 4px 0px;
    font-weight: 700;
}

QPushButton#botonAnio:hover {
    background-color: #262631;
}

QPushButton#botonAnio:pressed {
    background-color: #17171d;
}

QPushButton#botonAnio:disabled {
    background-color: #141418;
    color: #4a4a52;
    border-color: #232329;
}

QPushButton#botonLogoF1 {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
}

QPushButton#botonLogoF1:hover {
    background-color: #1c1c22;
}

QPushButton#botonLogoF1Fallback {
    background-color: #e10600;
    color: white;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 1px;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton#botonLogoF1Fallback:hover {
    background-color: #ff2410;
}

/* ---------- Sidebar de navegación ---------- */

QWidget#sidebarPrincipal {
    background-color: #111116;
    border-right: 1px solid #2a2a33;
}

QPushButton#navLateral {
    background-color: transparent;
    color: #9a9aa5;
    text-align: left;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 4px;
    padding: 10px 12px;
    font-weight: 600;
}

QPushButton#navLateral:hover {
    background-color: #1a1a20;
    color: #f0f0f0;
    border-left: 3px solid #5a1a17;
}

QPushButton#navLateral:checked {
    background-color: #1e1e26;
    color: #ffffff;
    border-left: 3px solid #e10600;
}

/* ---------- Pestañas horizontales (standings) ---------- */

QPushButton#tabHorizontal {
    background-color: #17171d;
    color: #b6b6bd;
    border: 1px solid #2a2a33;
    border-bottom: 3px solid transparent;
    border-radius: 4px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton#tabHorizontal:hover {
    background-color: #1e1e26;
    color: #f0f0f0;
}

QPushButton#tabHorizontal:checked {
    background-color: #241a1a;
    color: #ffffff;
    border-bottom: 3px solid #e10600;
}

/* Fondo con un ligero degradé vertical en vez de un plano parejo. */
QWidget#vistaPrincipal {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #111116,
        stop: 0.5 #0d0d11,
        stop: 1 #08080a
    );
}

QLabel {
    color: #f0f0f0;
}

/* ---------- Encabezados ---------- */

QLabel#titulo {
    font-size: 22px;
    font-weight: 700;
    color: #f5f5f5;
    padding: 2px 0px;
}

QLabel#subtitulo {
    font-size: 13px;
    color: #9a9aa5;
    padding-bottom: 6px;
}

QFrame#lineaAcento {
    background-color: #e10600;
    max-height: 3px;
    min-height: 3px;
    border: none;
    border-radius: 1px;
}

QLabel#badgeRonda {
    background-color: #1e1e26;
    border: 1px solid #3a3a45;
    border-radius: 4px;
    color: #d0d0d5;
    font-weight: 700;
    font-size: 11px;
    padding: 3px 8px;
}

/* ---------- Botones genéricos (año, volver) ---------- */

QPushButton {
    background-color: #e10600;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #ff2410;
}

QPushButton:pressed {
    background-color: #a80500;
}

QPushButton:disabled {
    background-color: #2a2a33;
    color: #6a6a74;
}

/* ---------- Selector de año ---------- */

QLineEdit {
    background-color: #1e1e26;
    border: 1px solid #3a3a45;
    border-radius: 4px;
    padding: 5px 6px;
    color: #f0f0f0;
    font-weight: 600;
}

QLineEdit:focus {
    border: 1px solid #e10600;
}

/* ---------- Tarjetas de calendario ---------- */

QWidget#tarjetaEvento {
    background-color: #1e1e26;
    border: 1px solid #2a2a33;
    border-left: 4px solid #3a3a45;
    border-radius: 6px;
}

QWidget#tarjetaEvento[estado="proxima"] {
    border-left: 4px solid #e10600;
    background-color: #241a1a;
}

QWidget#tarjetaEvento[estado="pasado"] {
    border-left: 4px solid #4a4a54;
}

QWidget#tarjetaEvento[estado="futuro"] {
    border-left: 4px solid #1f5fa8;
}

/* Reacción al pasar el mouse: además del crecimiento animado en Python,
   la superficie se aclara y el borde de acento se enciende un poco. */
QWidget#tarjetaEvento:hover {
    background-color: #262631;
    border: 1px solid #3a3a45;
}

QWidget#tarjetaEvento[estado="proxima"]:hover {
    background-color: #2c1e1e;
    border-left: 4px solid #ff2410;
}

QWidget#tarjetaEvento[estado="pasado"]:hover {
    border-left: 4px solid #6a6a76;
}

QWidget#tarjetaEvento[estado="futuro"]:hover {
    border-left: 4px solid #2f7bd1;
}

QLabel#nombreEvento {
    font-weight: 700;
    font-size: 13px;
    background: transparent;
    color: #f5f5f5;
}

QLabel#paisEvento {
    background: transparent;
    color: #b6b6bd;
    font-size: 12px;
}

QLabel#fechaEvento {
    background: transparent;
    color: #7d7d87;
    font-size: 11px;
}

QLabel#etiquetaRonda {
    background: transparent;
    color: #7d7d87;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QLabel#etiquetaProxima {
    background-color: #e10600;
    color: white;
    font-size: 9px;
    font-weight: 700;
    border-radius: 3px;
    padding: 2px 5px;
}

/* ---------- Pestañas de sesión (event detail, estilo broadcast) ---------- */

QPushButton#tabSesion {
    background-color: #17171d;
    color: #b6b6bd;
    text-align: left;
    border: 1px solid #2a2a33;
    border-left: 3px solid transparent;
    border-radius: 4px;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#tabSesion:hover:enabled {
    background-color: #1e1e26;
    color: #f0f0f0;
    border-left: 3px solid #5a1a17;
}

QPushButton#tabSesion:checked {
    background-color: #241a1a;
    color: #ffffff;
    border-left: 3px solid #e10600;
    border-top: 1px solid #3a3a45;
    border-right: 1px solid #3a3a45;
    border-bottom: 1px solid #3a3a45;
}

QPushButton#tabSesion:disabled {
    background-color: #141418;
    color: #4a4a52;
    border-left: 3px solid transparent;
}

/* ---------- Estado (cargando / error) ---------- */

QLabel#estadoCargando {
    color: #d9a441;
    font-style: italic;
    padding: 4px 0px;
}

QLabel#estadoError {
    color: #ff4d4d;
    font-weight: 600;
    padding: 4px 0px;
}

QLabel#estadoVacio {
    color: #9a9aa5;
    font-style: italic;
    padding: 4px 0px;
}

/* ---------- Tabla de resultados, estilo pantalla de timing ---------- */

QTableWidget {
    background-color: #17171d;
    alternate-background-color: #1b1b22;
    gridline-color: #262631;
    border: 1px solid #2a2a33;
    border-radius: 4px;
    selection-background-color: #2a2a33;
    selection-color: #f0f0f0;
}

QTableWidget::item {
    padding: 4px 6px;
    border-bottom: 1px solid #232329;
}

QHeaderView::section {
    background-color: #e10600;
    color: white;
    padding: 7px 6px;
    border: none;
    border-right: 1px solid #a80500;
    font-weight: 700;
    font-size: 11px;
}

QTableWidget QScrollBar:vertical {
    background: #17171d;
    width: 10px;
    margin: 0px;
}

QTableWidget QScrollBar::handle:vertical {
    background: #3a3a45;
    border-radius: 5px;
    min-height: 24px;
}

QTableWidget QScrollBar::handle:vertical:hover {
    background: #4a4a58;
}

QTableWidget QScrollBar::add-line:vertical,
QTableWidget QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ---------- ScrollArea del calendario ---------- */

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea QScrollBar:vertical {
    background: #0b0b0e;
    width: 10px;
    margin: 0px;
}

QScrollArea QScrollBar::handle:vertical {
    background: #3a3a45;
    border-radius: 5px;
    min-height: 24px;
}

QScrollArea QScrollBar::handle:vertical:hover {
    background: #e10600;
}

QScrollArea QScrollBar::add-line:vertical,
QScrollArea QScrollBar::sub-line:vertical {
    height: 0px;
}
